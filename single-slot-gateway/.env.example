HOST=0.0.0.0
PORT=8790
VM2API_BASE_URL=http://127.0.0.1:8787
SINGLE_SLOT_VM_ID=vm-01
VM2API_PROJECT_ROOT=/vm2api
PREFLIGHT_REQUIRED=1
ALLOW_LOCAL_EGRESS=0
MAX_CONCURRENCY=2
MAX_WAITERS=32
QUEUE_TIMEOUT_MS=120000
UPSTREAM_IDLE_TIMEOUT_MS=180000
TRUST_INBOUND_SESSION=1
# Prefer *_FILE in production.
INBOUND_API_KEY=replace-with-sub2api-to-gateway-secret
VM2API_UPSTREAM_KEY=sk-vm-replace-with-managed-key
